# ─────────────────────────────────────────────────────────────────────────────
# SPIT RAG Chatbot — Environment Configuration
# CE413 Generative AI Lab | Experiment 8
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (pick one block) ────────────────────────────────────────────

# [G] Groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_JUDGE_MODEL=qwen/qwen3.8-27b

# ── Which provider to use ────────────────────────────────────────────────────
# Options: openai | gemini | anthropic | ollama | groq
LLM_PROVIDER=groq

# ── Hugging Face Hub (optional, prevents rate-limits during download) ──────────
HF_TOKEN=your_huggingface_token_here

# ── Embedding model ──────────────────────────────────────────────────────────
# Model A (default, fast)
EMBED_MODEL_A=BAAI/bge-small-en-v1.5
# Model B (advanced challenge)
EMBED_MODEL_B=BAAI/bge-base-en-v1.5

# Which embed model to use by default: A or B
EMBED_MODEL=A

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base

# ── Pipeline defaults ─────────────────────────────────────────────────────────
DEFAULT_K=3
DEFAULT_RETRIEVER=hybrid          # dense | bm25 | hybrid | mmr | rerank
DEFAULT_CHUNKER=C1                # C1 | C2 | C3 | C4 | C5 | C6
RELEVANCE_THRESHOLD=0.0           # set > 0 to activate threshold gate (e.g. 0.4)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# ── Paths ─────────────────────────────────────────────────────────────────────
KB_DIR=kb
INDEX_DIR=indexes
RESULTS_DIR=results

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Web Scraper ───────────────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=2.5
CRAWL_MAX_PAGES=80
SCRAPER_USER_AGENT="SPITRagBot/1.0 (academic-research; CE413)"
